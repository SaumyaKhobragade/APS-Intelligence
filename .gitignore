# -----------------------------------------------------------------------------
# Operating-system and editor files
# -----------------------------------------------------------------------------
.DS_Store
Thumbs.db
*.swp
*.swo
.idea/
.vscode/

# -----------------------------------------------------------------------------
# Node.js / Next.js frontend
# -----------------------------------------------------------------------------
**/node_modules/
**/.next/
**/out/
**/build/
**/.turbo/
**/.vercel/
**/.pnp
**/.pnp.js
**/*.tsbuildinfo
**/coverage/
next-env.d.ts
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# -----------------------------------------------------------------------------
# Python backend and virtual environments
# -----------------------------------------------------------------------------
**/.venv/
**/venv/
**/env/
**/__pycache__/
**/*.py[cod]
**/*.pyo
**/.pytest_cache/
**/.mypy_cache/
**/.ruff_cache/
**/.tox/
**/htmlcov/
*.egg-info/
*.egg

# -----------------------------------------------------------------------------
# Environment files: keep templates such as .env.example trackable
# -----------------------------------------------------------------------------
**/.env
**/.env.*
!**/.env.example
*.pem

# -----------------------------------------------------------------------------
# Databases, logs and local runtime state
# -----------------------------------------------------------------------------
**/*.db
**/*.sqlite
**/*.sqlite3
**/*.db-journal
**/*.log
backend/data/

# -----------------------------------------------------------------------------
# APS datasets and generated artifacts
# Keep source code, README files, configuration templates and tests trackable.
# -----------------------------------------------------------------------------
backend/datasets/raw/*
backend/datasets/reference/*
backend/datasets/processed/*
backend/artifacts/models/*
backend/artifacts/reports/*
backend/artifacts/tmp/

# Preserve empty storage directory markers.
!backend/datasets/raw/.gitkeep
!backend/datasets/reference/.gitkeep
!backend/datasets/processed/.gitkeep
!backend/artifacts/models/.gitkeep

# Temporary exports and generated report files outside the backend tree.
reports/
tmp/
temp/
!backend/artifacts/reports/.gitkeep
