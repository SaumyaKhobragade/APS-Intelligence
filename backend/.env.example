# APS Intelligence backend configuration
APP_NAME=APS Intelligence API
APP_VERSION=0.1.0
ENVIRONMENT=development
API_PREFIX=/api/v1
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
PERSISTENT_STORAGE_DIR=./data
