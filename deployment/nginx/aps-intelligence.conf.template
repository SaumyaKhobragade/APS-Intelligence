# =============================================================================
# APS Intelligence - Production Nginx Reverse Proxy Configuration Template
# =============================================================================
# Replace the following placeholders before enabling:
#   ${DOMAIN_NAME}        - e.g. aps.yourdomain.com
#   ${SSL_CERTIFICATE}    - Path to fullchain.pem (e.g. /etc/letsencrypt/live/aps.yourdomain.com/fullchain.pem)
#   ${SSL_KEY}            - Path to privkey.pem (e.g. /etc/letsencrypt/live/aps.yourdomain.com/privkey.pem)
#
# Use deployment/scripts/render_nginx_conf.py for safe placeholder substitution.
# =============================================================================

# Map WebSocket upgrade headers cleanly
map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

# Upstream definitions (bound strictly to loopback)
upstream aps_frontend {
    server 127.0.0.1:3000;
    keepalive 32;
}

upstream aps_backend {
    server 127.0.0.1:8000;
    keepalive 32;
}

# HTTP - Redirect all traffic to HTTPS (preserving ACME challenge path)
server {
    listen 80;
    listen [::]:80;
    server_name ${DOMAIN_NAME};

    # Let's Encrypt ACME challenge location
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
        allow all;
    }

    # Redirect to HTTPS
    location / {
        return 301 https://$host$request_uri;
    }
}

# HTTPS - Primary Application Server
server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name ${DOMAIN_NAME};

    # SSL Certificates
    ssl_certificate ${SSL_CERTIFICATE};
    ssl_certificate_key ${SSL_KEY};
    ssl_session_timeout 1d;
    ssl_session_cache shared:SSL:10m;
    ssl_session_tickets off;

    # Modern SSL Protocols & Ciphers
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384;
    ssl_prefer_server_ciphers off;

    # Security Headers
    add_header X-Frame-Options "DENY" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-XSS-Protection "1; mode=block" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Strict-Transport-Security "max-age=63072000; includeSubDomains; preload" always;

    # Request limits & timeouts
    client_max_body_size 50M;
    client_body_timeout 30s;
    client_header_timeout 30s;

    # Gzip Compression
    gzip on;
    gzip_vary on;
    gzip_proxied any;
    gzip_comp_level 6;
    gzip_types text/plain text/css text/xml application/json application/javascript application/rss+xml font/woff font/woff2 image/svg+xml;

    # 1. Backend API Routing: /api/v1/* and OpenAPI documentation
    location /api/ {
        proxy_pass http://aps_backend;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection "";

        proxy_connect_timeout 15s;
        proxy_send_timeout 60s;
        proxy_read_timeout 60s;
    }

    location /docs {
        proxy_pass http://aps_backend/docs;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /openapi.json {
        proxy_pass http://aps_backend/openapi.json;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # 2. Next.js Static Asset Caching (_next/static)
    location /_next/static/ {
        proxy_pass http://aps_frontend;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        expires 365d;
        access_log off;
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    # 3. Frontend Application Routing: All other requests
    location / {
        proxy_pass http://aps_frontend;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_connect_timeout 15s;
        proxy_send_timeout 30s;
        proxy_read_timeout 30s;
    }
}
